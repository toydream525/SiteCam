 @Builder coverPreview(){Column({space:12}){Text('小折叠外屏布局预览（模拟尺寸）').fontSize(16);Text(`${this.coverSizes[this.coverSize][0]} × ${this.coverSizes[this.coverSize][1]} · 点击 ${this.coverTaps}`).id('cover-qa-status');Stack({alignContent:Alignment.TopStart}){Rect().width('100%').height('100%').fill('#263238');FoldCoverControls({panelWidth:cameraLayout(this.coverSizes[this.coverSize][0],this.coverSizes[this.coverSize][1],3/4,false,-1,0,true).controlsWidth,panelHeight:cameraLayout(this.coverSizes[this.coverSize][0],this.coverSizes[this.coverSize][1],3/4,false,-1,0,true).controlsHeight,canCapture:true,canSwitch:true,onCapture:()=>this.coverTaps++}).position({x:cameraLayout(this.coverSizes[this.coverSize][0],this.coverSizes[this.coverSize][1],3/4,false,-1,0,true).controlsX,y:cameraLayout(this.coverSizes[this.coverSize][0],this.coverSizes[this.coverSize][1],3/4,false,-1,0,true).controlsY});}.width(this.coverSizes[this.coverSize][0]).height(this.coverSizes[this.coverSize][1]).id('cover-qa-frame');Button('下一尺寸').onClick(()=>this.coverSize=(this.coverSize+1)%this.coverSizes.length);Button('返回测试').onClick(()=>this.coverDemo=false);}.width('100%').height('100%').justifyContent(FlexAlign.Center);}
