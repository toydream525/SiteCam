class Result {name: string='';pass: boolean=false;message: string='';}
function gpsDms(value: string): number { const p=value.split(',').map((v:string)=>Number(v.trim())); if(p.length!==3||p.some((v:number)=>!Number.isFinite(v)))throw new Error('GPS EXIF不是DMS格式'); return p[0]+p[1]/60+p[2]/3600; }
@Entry @Component
struct Verification {
 @State results: Result[]=[];
 @State finished: boolean=false;
 private sample: MediaItem=new MediaItem();
 private sampleProject: Project=new Project();
 private ctx: common.UIAbilityContext=getContext(this) as common.UIAbilityContext;
 private async check(name: string,run: ()=>Promise<void>): Promise<void>{const r=new Result();r.name=name;try{await run();r.pass=true;}catch(e){r.message=(e as Error).message;}this.results=this.results.concat(r);if(this.finished){const report=fs.openSync(this.ctx.filesDir+'/verification.json',fs.OpenMode.CREATE|fs.OpenMode.READ_WRITE|fs.OpenMode.TRUNC);fs.writeSync(report.fd,JSON.stringify(this.results,null,2));fs.closeSync(report);}console.info('SITECAM_TEST '+JSON.stringify(r));}
 private assert(value: boolean,message: string): void {if(!value)throw new Error(message);}
 async aboutToAppear(): Promise<void> {console.info('SITECAM_FOLDERCAP '+canIUse('SystemCapability.FileManagement.UserFileService.FolderSelection'));const files=new MediaService(this.ctx);const project=new Project();project.name='鸿蒙验收工程';project.address='这是用于验证长地址自动换行的完整现场位置，北段雨水管施工现场三号检查井旁，最后一行必须完整显示';const settings=new Settings();const snap=captureSnapshot(project,settings,null);
  await this.check('定位新鲜度及快照隔离',async()=>{const f=new Fix();f.timestamp=Date.now()-600000;const s=captureSnapshot(project,settings,f);this.assert(s.locationStatus==='STALE','旧定位被当作实时定位');settings.watermark.style='INFO_BOARD';this.assert(s.watermark.style==='CLASSIC','快照受后续设置影响');this.assert(resolveFields(s).some(v=>v.value.includes('旧定位')),'未显示旧定位标识');});
  await this.check('核心数据字段与事务对齐',async()=>{const db=new Store('parity_'+Date.now());await db.open(this.ctx);try{await DataParityChecks.check(db);}finally{await db.close();}}); await this.check('设置与模板重开持久化',async()=>{await DataParityChecks.templateReopenFixture(this.ctx);}); await this.check('旧v2数据库升级保留',async()=>{await DataParityChecks.upgradeFixture(this.ctx);}); await this.check('导出交付失败完整报告',async()=>{await DataParityChecks.exportDeliveryFixture(this.ctx);}); await this.check('压缩导出EXIF保留',async()=>{await DataParityChecks.exportExifFixture(this.ctx);});
  await this.check('手机横屏与悬停布局边界',async()=>{for(const size of [[360,800],[412,915],[599,800],[600,800],[839,800],[840,800],[1280,800],[360,400]]){for(const ratio of [3/4,4/3]){const l=cameraLayout(size[0],size[1],ratio);this.assert(l.previewX>=0&&l.previewY>=0&&l.previewX+l.previewWidth<=size[0]+1&&l.previewY+l.previewHeight<=size[1]+1,'取景超出窗口');this.assert(Math.abs(l.previewWidth/l.previewHeight-ratio)<.001,'取景拉伸');this.assert(l.controlsX+l.controlsWidth<=size[0]+1&&l.controlsY+l.controlsHeight<=size[1]+1,'按钮超出窗口');}}const h=cameraLayout(800,1000,4/3,true,490,20);this.assert(h.hover&&h.previewY+h.previewHeight<=484&&h.controlsY>=540,'悬停折痕避让失败');const invalid=cameraLayout(360,800,3/4,true,-1,0);this.assert(!invalid.hover,'未知折痕不应启用悬停');});
  await this.check('三向拍摄及倒置保持',async()=>{this.assert(captureDegrees('AUTO',180,90)===90&&captureDegrees('AUTO',180,270)===270,'倒置翻转');this.assert(captureDegrees('LEFT',0,0)===90&&captureDegrees('RIGHT',0,0)===270&&captureDegrees('PORTRAIT',90,90)===0,'固定方向错误');});
  await this.check('日期筛选规则',async()=>{DateRangeDialogChecks.check();});
  for(const style of STYLES){await this.check('水印完整布局 '+style.id,async()=>{snap.watermark.style=style.id;const canvas=new OffscreenCanvas(1080,1440,LengthMetricsUnit.PX);const ctx=canvas.getContext('2d');const layout=layoutWatermark(ctx,1080,1440,snap);this.assert(layout.x>=0&&layout.y>=0&&layout.x+layout.w<=1080&&layout.y+layout.h<=1440,'卡片超出照片');for(const l of layout.lines){this.assert(l.x>=layout.x-1&&l.y-l.ascent>=layout.y-1,'文字顶部/左侧超出卡片');this.assert(l.x+l.width<=layout.x+layout.w+1,'文字右侧超出卡片');this.assert(l.y+l.descent<=layout.y+layout.h+1,'文字末行被裁切');}const pm=watermarkPixelMap(1080,1440,snap);try{const pack=image.createImagePacker();try{await files.write(this.ctx.filesDir+'/test_'+style.id+'.png',await pack.packing(pm,{format:'image/png',quality:100}));}finally{await pack.release();}}finally{await pm.release();}});}
  await this.check('水印横竖屏大字号与长地址边界',async()=>{const longSnap=JSON.parse(JSON.stringify(snap)) as Snapshot;longSnap.address='这是用于验证折叠屏窄窗口和横竖屏布局的超长现场位置，北段雨水管施工现场三号检查井旁，最后一行必须完整显示且不能越过卡片边界';for(const style of STYLES)for(const scale of [.6,2])for(const size of [[1080,1440],[1440,1080],[480,800]]){longSnap.watermark.style=style.id;longSnap.watermark.fontScale=scale;const canvas=new OffscreenCanvas(size[0],size[1],LengthMetricsUnit.PX);const layout=layoutWatermark(canvas.getContext('2d'),size[0],size[1],longSnap);this.assert(layout.x>=0&&layout.y>=0&&layout.x+layout.w<=size[0]&&layout.y+layout.h<=size[1],style.id+'卡片边界失败');for(const l of layout.lines)this.assert(l.x>=layout.x-1&&l.x+l.width<=layout.x+layout.w+1&&l.y-l.ascent>=layout.y-1&&l.y+l.descent<=layout.y+layout.h+1,style.id+'文字边界失败');}});
  const pixels=new Uint8Array(3000*2000*4);for(let yy=0;yy<2000;yy++)for(let xx=0;xx<3000;xx++){const i=(yy*3000+xx)*4;pixels[i]=20+xx%80;pixels[i+1]=30+yy%80;pixels[i+2]=160;pixels[i+3]=255;}const base=await image.createPixelMap(pixels.buffer,{editable:true,pixelFormat:image.PixelMapFormat.RGBA_8888,size:{width:3000,height:2000}});const pack=image.createImagePacker();const bytes=await pack.packing(base,{format:'image/jpeg',quality:95});await pack.release();await base.release();
  await this.check('手机取景比例与保存中心裁剪',async()=>{for(const ratio of [3/4,4/3]){const shot=JSON.parse(JSON.stringify(snap)) as Snapshot;shot.captureRatio=ratio;const m=await files.capture(bytes,shot,3,0);this.assert(Math.abs(m.width/m.height-ratio)<.002,'保存画幅不同于取景');this.assert(m.width<=3000&&m.height<=2000,'裁剪放大原图');const source=image.createImageSource(m.path);try{this.assert(!!(await source.getImageProperty(image.PropertyKey.DATE_TIME_ORIGINAL)),'裁剪后缺失EXIF');}finally{await source.release();}}});
  await this.check('冻结快照定位零值负值与原件元数据',async()=>{const geo=JSON.parse(JSON.stringify(snap)) as Snapshot;const fix=new Fix();fix.latitude=0;fix.longitude=-122.4194;fix.altitude=-3;fix.accuracy=4.5;fix.timestamp=geo.timestamp;fix.address='负经度测试地址';geo.fix=fix;geo.address=fix.address;geo.locationStatus='FRESH';const m=await files.capture(bytes,geo,0,0);const saved=JSON.parse(m.snapshot) as Snapshot;this.assert(m.projectId===geo.projectId&&m.latitude===0&&m.longitude===-122.4194&&m.altitude===-3&&m.locationAccuracy===4.5&&m.locationTimestamp===fix.timestamp,'MediaItem定位字段未跟随冻结快照');this.assert(saved.fix!==null&&saved.fix.latitude===0&&saved.fix.longitude===-122.4194&&saved.address===geo.address,'原件snapshot定位漂移');const src=image.createImageSource(m.path);try{const lat=await src.getImageProperty(image.PropertyKey.GPS_LATITUDE);const lon=await src.getImageProperty(image.PropertyKey.GPS_LONGITUDE);const latRef=await src.getImageProperty(image.PropertyKey.GPS_LATITUDE_REF);const lonRef=await src.getImageProperty(image.PropertyKey.GPS_LONGITUDE_REF);this.assert(Math.abs(gpsDms(lat)-0)<.0002&&Math.abs(gpsDms(lon)-122.4194)<.0002&&latRef==='N'&&lonRef==='W','GPS EXIF DMS与冻结定位不一致');}finally{await src.release();}});
  for(let q=0;q<4;q++){await this.check('照片编码、方向和 EXIF '+q,async()=>{const m=await files.capture(bytes,snap,q,90);if(q===1)this.sample=m;const src=image.createImageSource(m.path);try{const info=await src.getImageInfo();this.assert(info.size.height===[1280,1920,2560,3000][q]&&info.size.width<info.size.height,'方向或尺寸错误');const date=await src.getImageProperty(image.PropertyKey.DATE_TIME_ORIGINAL);this.assert(!!date,'缺少快门时间 EXIF');}finally{await src.release();}});}
  await this.check('编辑成品独立保存',async()=>{const m=await files.capture(bytes,snap,1,0);const r=new EditRecipe();r.rotation=90;r.flipX=true;const mark=new Mark();r.marks.push(mark);const out=await files.edit(m,r,1);this.assert(out!==m.path&&fs.accessSync(m.path)&&fs.accessSync(out),'编辑覆盖了原件');});
  snap.watermark.style='ENGINEERING_BLUE';for(const kind of ['arrow','rect','circle','freehand','text','mosaic']){await this.check('编辑工具落图 '+kind,async()=>{const m=await files.capture(bytes,snap,1,0);const r=new EditRecipe();const step=new EditStep(kind);step.mark.kind=kind;step.mark.x=.12;step.mark.y=.18;step.mark.endX=.7;step.mark.endY=.72;step.mark.text='标注';step.mark.points=[.12,.18,.35,.35,.55,.22,.7,.72];r.steps.push(step);const out=await files.edit(m,r,1);const src=image.createImageSource(out);let pm:image.PixelMap|null=null;try{pm=await src.createPixelMap({editable:false});const info:image.ImageInfo=await pm.getImageInfo();const raw=new ArrayBuffer(pm.getPixelBytesNumber());await pm.readPixelsToBuffer(raw);const px=new Uint8Array(raw);let yellow=0;for(let i=0;i+3<px.length;i+=4)if(px[i]>130&&px[i+1]>80&&px[i+2]<130)yellow++;if(kind==='mosaic'){const beforeSource=image.createImageSource(m.path);let before:image.PixelMap|null=null;try{before=await beforeSource.createPixelMap({editable:false});const oldRaw=new ArrayBuffer(before.getPixelBytesNumber());await before.readPixelsToBuffer(oldRaw);const oldPx=new Uint8Array(oldRaw);const oi=info.size.width;let local=0,far=0;for(let yy=0;yy<info.size.height;yy+=8)for(let xx=0;xx<oi;xx+=8){const at=(yy*oi+xx)*4;const diff=Math.abs(px[at]-oldPx[at])+Math.abs(px[at+1]-oldPx[at+1])+Math.abs(px[at+2]-oldPx[at+2]);if(xx>oi*.1&&xx<oi*.75&&yy>info.size.height*.1&&yy<info.size.height*.8){if(diff>12)local++;}else if(diff>12)far++;}this.assert(local>10&&far<local/3,'马赛克未沿轨迹改变局部像素');}finally{await before?.release();await beforeSource.release();}}else this.assert(yellow>20,'工具未在成品落图');}finally{await pm?.release();await src.release();}});}
  await this.check('数据库事务与升级保留',async()=>{const namespace='verification_'+Date.now();const db=new Store(namespace);await db.open(this.ctx);const p1=new Project();p1.name='事务A';const p2=new Project();p2.name='事务B';await db.putProject(p1);await db.putProject(p2);const m=new MediaItem();m.projectId=p1.id;m.issueTitle='管道接口';m.issueStatus='IN_PROGRESS';await db.putMedia(m);await db.moveMedia([m.id],p2.id);const list=await db.media();this.assert(list[0].projectId===p2.id&&list[0].issueStatus==='IN_PROGRESS','问题与媒体移动不一致');p2.locked=true;await db.putProject(p2);this.assert((await db.projects()).some(p=>p.locked),'工程锁定未保存');await db.close();const reopened=new Store(namespace);await reopened.open(this.ctx);this.assert((await reopened.media())[0].issueStatus==='IN_PROGRESS','重新打开后资料丢失');await reopened.close();});
  await this.check('模板设置和中断任务恢复',async()=>{const name='recovery_'+Date.now();const db=new Store(name);await db.open(this.ctx);const t=new WatermarkTemplate();t.name='复核模板';t.config=JSON.stringify(settings.watermark);await db.putTemplate(t);db.settings.templateId=t.id;await db.saveSettings();const m=new MediaItem();m.status='PROCESSING';m.source='/original.mp4';await db.putMedia(m);await db.close();const reopened=new Store(name);await reopened.open(this.ctx);this.assert(reopened.settings.templateId===t.id&&(await reopened.templates()).some(v=>v.name==='复核模板'),'模板或设置未保留');const recovered=(await reopened.media())[0];this.assert(recovered.status==='FAILED'&&recovered.source==='/original.mp4','中断任务错误标记完成或丢失原片路径');await reopened.close();});
  await this.check('连续裁剪及标注后旋转',async()=>{const m=await files.capture(bytes,snap,0,0);const r=new EditRecipe();const annotation=new EditStep('arrow');annotation.mark.x=.2;annotation.mark.y=.2;annotation.mark.endX=.6;annotation.mark.endY=.6;r.steps.push(annotation);r.steps.push(new EditStep('rotate'));const crop=new EditStep('crop');crop.mark.x=0;crop.mark.y=0;crop.mark.endX=.5;crop.mark.endY=.5;r.steps.push(crop);r.steps.push(crop);const output=await files.edit(m,r,3);const src=image.createImageSource(output);try{const info=await src.getImageInfo();this.assert(Math.abs(info.size.width-m.height/4)<=2&&Math.abs(info.size.height-m.width/4)<=2,'连续裁剪顺序错误');}finally{await src.release();}});
  await this.check('工程导出实际文件与缺失报告',async()=>{const m=await files.capture(bytes,snap,1,0);project.id=47;m.id=1;m.projectId=47;const missing=new MediaItem();missing.id=2;missing.projectId=47;missing.name='missing.jpg';missing.path=this.ctx.filesDir+'/does-not-exist.jpg';const stage=this.ctx.filesDir+'/export_test_'+Date.now();await fs.mkdir(stage);const exporter=new ExportService(this.ctx,files);await exporter.stage([project],[m,missing],stage,-1,()=>{});const dir=stage+'/鸿蒙验收工程_p47';const report=JSON.parse(fs.readTextSync(dir+'/export_report.json')) as ExportReport;this.assert(report.copiedMedia===1&&report.missingMedia===1,'缺失文件报告不准确');this.assert(fs.accessSync(dir+'/Photos/1_'+m.name),'实际照片未导出');await zlib.compressFile(stage,this.ctx.filesDir+'/verified_export.zip',{});this.assert((await fs.stat(this.ctx.filesDir+'/verified_export.zip')).size>0,'ZIP 文件为空');});
  await this.check('原生视频水印与音轨',async()=>{const bytes=await this.ctx.resourceManager.getRawFileContent('video_fixture.mp4');const source=this.ctx.filesDir+'/video_fixture.mp4',output=this.ctx.filesDir+'/video_result.mp4';await files.write(source,bytes.buffer as ArrayBuffer);snap.watermark.style='INFO_BOARD';const pm=watermarkPixelMap(320,240,snap);let rgba=new ArrayBuffer(pm.getPixelBytesNumber());await pm.readPixelsToBuffer(rgba);console.info('SITECAM_PIXELS '+JSON.stringify(await pm.getImageInfo()));await pm.release();await nativeVideo.transcode(source,output,rgba,320,240);await checkVideoFrames(source,output,rgba);});
  if(AppStorage.get<boolean>('seedQA')) {const mainContext=this.ctx.createModuleContext('entry');const db=new Store();await db.open(mainContext);const existing=await db.projects();if(!existing.some(p=>p.name==='鸿蒙适配验收')){for(let i=0;i<5;i++){const p=new Project();p.name=i===0?'鸿蒙适配验收':`现场记录 ${i+1}`;p.route='北段雨水管';p.address=project.address;await db.putProject(p);if(i===0){this.sample.projectId=p.id;await db.putMedia(this.sample);db.settings.currentProject=p.id;}}db.settings.guideDone=true;db.settings.permissionHandled=true;await db.saveSettings();}await db.close();}
  this.sampleProject=project;
  const f=fs.openSync(this.ctx.filesDir+'/verification.json',fs.OpenMode.CREATE|fs.OpenMode.READ_WRITE|fs.OpenMode.TRUNC);fs.writeSync(f.fd,JSON.stringify(this.results,null,2));fs.closeSync(f);this.finished=true;
 }
 build(){Column(){Text(this.finished?'测试完成':'正在验收').fontSize(24);if(this.finished){Row(){Button('验证相册副本').onClick(()=>this.check('系统相册副本保存与原件保留',async()=>{const files=new MediaService(this.ctx);const uri=await files.albumCopy(this.sample);this.assert(!!uri&&fs.accessSync(this.sample.path),'副本未保存或原件丢失');}));Button('验证文件夹导出').onClick(()=>this.check('系统目录导出',async()=>{const exporter=new ExportService(this.ctx,new MediaService(this.ctx));this.sample.projectId=this.sampleProject.id;const path=await exporter.run([this.sampleProject],[this.sample],true,-1,()=>{});this.assert(fs.accessSync(path),'导出目录不可访问');const dir=path+'/鸿蒙验收工程_p'+this.sampleProject.id;const report=JSON.parse(fs.readTextSync(dir+'/export_report.json')) as ExportReport;this.assert(report.copiedMedia===1&&report.missingMedia===0,'目录中的实际媒体数量错误');const source=image.createImageSource(dir+'/'+report.files[0].exportPath);try{const info=await source.getImageInfo();this.assert(info.size.width>0&&info.size.height>0,'目录成片无法解码');}finally{await source.release();}await new MediaService(this.ctx).write(this.ctx.filesDir+'/directory_result.txt',new util.TextEncoder().encodeInto(path).buffer as ArrayBuffer);}));}}Scroll(){Column(){ForEach(this.results,(r: Result)=>{Text(`${r.pass?'通过':'失败'} · ${r.name}\n${r.message}`).fontSize(14).fontColor(r.pass?'#167340':'#C03030').padding(6);});}}.layoutWeight(1);}.padding(18).height('100%');}
