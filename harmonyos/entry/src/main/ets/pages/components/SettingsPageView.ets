const BG:Resource=$r('app.color.page_bg');
const CARD:Resource=$r('app.color.card_bg');
const TEXT:Resource=$r('app.color.text_primary');
const MUTED:Resource=$r('app.color.text_secondary');
const YELLOW:string='#FFB300';
const PRIVACY:string='https://agreement-drcn.hispace.dbankcloud.cn/index.html?lang=zh&agreementId=2043675336696198208';
export interface QualityOption{label:string;description:string;value:number;}
@Component export struct SettingsPageView{
 @Prop snapshotEnabled:boolean=true;@Prop snapshotShutterSpeed:number=250;
 @Prop quality:number=1;@Prop albumCopy:boolean=false;@Prop shutterSoundEnabled:boolean=true;@Prop cameraControlStyle:string='NORMAL';@Prop icon:string='D';@Prop apiVersion:number=12;@Prop diagnostics:string='';@Prop templateId:number=0;
 @Prop qualities:QualityOption[]=[{label:'更小文件',description:'长边 1280 像素',value:0},{label:'标准省空间',description:'长边 1920 像素',value:1},{label:'较清晰',description:'长边 2560 像素',value:2},{label:'原尺寸高清',description:'保留原尺寸',value:3}];
 onSnapshot:(v:boolean)=>void=()=>{};onSnapshotShutter:(v:number)=>void=()=>{};
 onBack:()=>void=()=>{};onHelp:()=>void=()=>{};onWatermark:(id:number)=>void=()=>{};onQuality:(v:number)=>void=()=>{};onAlbumCopy:(v:boolean)=>void=()=>{};onShutterSound:(v:boolean)=>void=()=>{};onCameraControlStyle:(v:string)=>void=()=>{};onIcon:(v:string)=>void=()=>{};onCopyDiagnostics:()=>void=()=>{};onOpenLink:(url:string)=>void=()=>{};onOpenEasterEgg:()=>void=()=>{};onPermissions:()=>void=()=>{};
 @State versionTapCount:number=0;@Link page:string;@State selectedGroup:string='拍摄与保存';@State availableWidth:number=390;
 @StorageProp('fontSizeScale') fontScale:number=1;
 private wide():boolean{return this.availableWidth>=Math.max(840,680*Math.max(1,this.fontScale)+48);}
 private versionTapAt:number=0;
 private versionTapped():void{const now=Date.now();this.versionTapCount=now-this.versionTapAt<=1500?this.versionTapCount+1:1;this.versionTapAt=now;if(this.versionTapCount>=5){this.versionTapCount=0;this.versionTapAt=0;this.onOpenEasterEgg();}}
 private iconName(id:string):string{return id==='A'?'蓝图镜头':id==='B'?'工程印记':id==='C'?'现场坐标':'工程现场';}
 private back():void{if(this.page==='设置')this.onBack();else this.page='设置';}
 @Builder row(title:string,value:string,press:()=>void){Row({space:12}){Text(title).fontSize(16).fontColor(TEXT).layoutWeight(1);if(value)Text(value).fontSize(14).fontColor(MUTED).constraintSize({maxWidth:180});Text('›').fontSize(24).fontColor(MUTED);}.width('100%').constraintSize({minHeight:64}).padding({left:16,right:16,top:12,bottom:12}).onClick(press);}
 @Builder groupHeader(title:string){Text(title).fontSize(15).fontColor(MUTED).width('100%').padding({left:8,top:12,bottom:8});}
 @Builder group(group:string){Column(){this.groupHeader(group);Column(){
  if(group==='拍摄与保存'){
   Row(){Text('抓拍模式').fontSize(16).fontColor(TEXT).layoutWeight(1);Toggle({type:ToggleType.Switch,isOn:this.snapshotEnabled}).selectedColor(YELLOW).onChange(v=>this.onSnapshot(v));}.width('100%').constraintSize({minHeight:64}).padding({left:16,right:16});
   this.row('抓拍快门','1/'+this.snapshotShutterSpeed,()=>this.page='抓拍快门');
   this.row('照片画质',this.qualities[this.quality]?.label||'标准省空间',()=>this.page='照片画质');
   Row(){Text('快门声音').fontSize(16).fontColor(TEXT).layoutWeight(1);Toggle({type:ToggleType.Switch,isOn:this.shutterSoundEnabled}).selectedColor(YELLOW).onChange(v=>this.onShutterSound(v));}.width('100%').constraintSize({minHeight:64}).padding({left:16,right:16});
   Row(){Text('另存到系统相册').fontSize(16).fontColor(TEXT).layoutWeight(1);Toggle({type:ToggleType.Switch,isOn:this.albumCopy}).selectedColor(YELLOW).onChange(v=>this.onAlbumCopy(v));}.width('100%').constraintSize({minHeight:64}).padding({left:16,right:16});
  }else if(group==='水印'){this.row('水印样式与字段','',()=>this.onWatermark(this.templateId));}
  else if(group==='权限与隐私'){this.row('权限设置','',()=>this.onPermissions());this.row('隐私政策','',()=>this.onOpenLink(PRIVACY));}
  else if(group==='外观'){this.row('相机控件外观',this.cameraControlStyle==='BLUR'?'毛玻璃':'普通',()=>this.page='相机控件外观');if(this.apiVersion>=26)this.row('桌面图标',this.iconName(this.icon),()=>this.page='桌面图标');}
  else{this.row('使用指南','',()=>this.onHelp());this.row('关于 SiteCam','',()=>this.page='关于 SiteCam');}
 }.width('100%').backgroundColor(CARD).borderRadius(16);}.width('100%');}
 @Builder content(){
  if(this.page==='设置'){Column({space:12}){if(this.wide()){if(this.selectedGroup==='拍摄与保存')this.group('拍摄与保存');else if(this.selectedGroup==='水印')this.group('水印');else if(this.selectedGroup==='权限与隐私')this.group('权限与隐私');else if(this.selectedGroup==='外观')this.group('外观');else this.group('帮助与关于');}else ForEach(['拍摄与保存','水印','权限与隐私','外观','帮助与关于'],(group:string)=>this.group(group),(group:string)=>group);}.width('100%');}
  else if(this.page==='抓拍快门'){Column(){ForEach([125,250,500,1000],(speed:number)=>Row(){Text('1/'+speed).fontSize(17).fontColor(TEXT).layoutWeight(1);Radio({value:speed.toString(),group:'snapshot-shutter'}).checked(this.snapshotShutterSpeed===speed).radioStyle({checkedBackgroundColor:YELLOW,uncheckedBorderColor:MUTED,indicatorColor:'#231A00'}).onChange(v=>{if(v)this.onSnapshotShutter(speed);});}.width('100%').padding(16).constraintSize({minHeight:64}).onClick(()=>this.onSnapshotShutter(speed)),(speed:number)=>speed.toString());}.width('100%').backgroundColor(CARD).borderRadius(16);}
  else if(this.page==='照片画质'){Column(){ForEach(this.qualities,(q:QualityOption)=>Row({space:12}){Column({space:4}){Text(q.label).fontSize(18).fontWeight(FontWeight.Bold).fontColor(TEXT);Text(q.description).fontSize(15).fontColor(MUTED);}.layoutWeight(1).alignItems(HorizontalAlign.Start);Radio({value:q.value.toString(),group:'photo-quality'}).checked(this.quality===q.value).radioStyle({checkedBackgroundColor:YELLOW,uncheckedBorderColor:MUTED,indicatorColor:'#231A00'}).onChange(v=>{if(v)this.onQuality(q.value);});}.padding(16).width('100%').constraintSize({minHeight:88}).onClick(()=>this.onQuality(q.value)),(q:QualityOption)=>q.value.toString());}.width('100%').backgroundColor(CARD).borderRadius(16);}
  else if(this.page==='桌面图标'){Column(){ForEach(['A','B','C','D'],(id:string)=>Row({space:16}){Image(id==='A'?$r('app.media.icon_a'):id==='B'?$r('app.media.icon_b'):id==='C'?$r('app.media.icon_c'):$r('app.media.app_icon')).width(64).height(64).borderRadius(16);Text(id+'  '+this.iconName(id)).fontSize(17).fontColor(TEXT).layoutWeight(1);Radio({value:id,group:'app-icon'}).checked(this.icon===id).enabled(this.apiVersion>=26).radioStyle({checkedBackgroundColor:YELLOW,uncheckedBorderColor:MUTED,indicatorColor:'#231A00'}).onChange(v=>{if(v&&this.apiVersion>=26)this.onIcon(id);});}.width('100%').padding(16).enabled(this.apiVersion>=26||id==='D').onClick(()=>{if(this.apiVersion>=26)this.onIcon(id);}), (id:string)=>id);}.width('100%').backgroundColor(CARD).borderRadius(16);}
  else if(this.page==='相机控件外观'){Column(){ForEach(['NORMAL','BLUR'],(style:string)=>Row(){Text(style==='BLUR'?'毛玻璃':'普通').fontSize(17).fontColor(TEXT).layoutWeight(1);Radio({value:style,group:'control-style'}).checked(this.cameraControlStyle===style).radioStyle({checkedBackgroundColor:YELLOW,uncheckedBorderColor:MUTED,indicatorColor:'#231A00'}).onChange(v=>{if(v)this.onCameraControlStyle(style);});}.width('100%').padding(16).constraintSize({minHeight:64}).onClick(()=>this.onCameraControlStyle(style)),(style:string)=>style);}.width('100%').backgroundColor(CARD).borderRadius(16);}
  else{Column({space:14}){Image($r('app.media.app_icon')).width(120).height(120).borderRadius(24);Text('工程水印相机').fontSize(26).fontWeight(FontWeight.Bold).fontColor(TEXT);Text('SiteCam').fontSize(20).fontColor(MUTED);Text('版本 0.4.2').fontSize(16).fontColor(MUTED).padding(8).onClick(()=>this.versionTapped());}.width('100%').padding({top:24,bottom:24});Column(){this.row('使用指南','',()=>this.onHelp());this.row('隐私政策','',()=>this.onOpenLink(PRIVACY));this.row('官网与下载','',()=>this.onOpenLink('https://yuriaqua.com/sitecam/'));this.row('设备诊断','',()=>this.onCopyDiagnostics());}.width('100%').backgroundColor(CARD).borderRadius(16);}
  if(this.page==='照片画质'||this.page==='桌面图标')Button('完成').width('100%').constraintSize({minHeight:52}).fontColor('#231A00').backgroundColor(YELLOW).margin({top:20}).onClick(()=>this.page='设置');
 }
 build(){Column(){Row({space:12}){Button(){Image($r('app.media.ic_arrow_back')).width(24).height(24).fillColor(TEXT);}.width(48).height(48).backgroundColor(Color.Transparent).accessibilityText('返回').onClick(()=>this.back());Text(this.page).fontSize(21).fontWeight(FontWeight.Bold).fontColor(TEXT).layoutWeight(1);}.constraintSize({minHeight:64}).width('100%').padding({left:8,right:16});Row(){if(this.wide()&&this.page==='设置')Scroll(){Column({space:12}){ForEach(['拍摄与保存','水印','权限与隐私','外观','帮助与关于'],(group:string)=>Button(group).width('100%').constraintSize({minHeight:64}).fontColor(TEXT).backgroundColor(this.selectedGroup===group?'#FFB30033':Color.Transparent).borderRadius(12).onClick(()=>this.selectedGroup=group),(group:string)=>group);}.padding(16);}.edgeEffect(EdgeEffect.Spring).width(260).height('100%');Scroll(){Column({space:12}){this.content();}.constraintSize({maxWidth:720}).width('100%').padding(16).alignItems(HorizontalAlign.Start);}.edgeEffect(EdgeEffect.Spring).scrollBar(BarState.Auto).layoutWeight(1).height('100%').align(Alignment.Top);}.layoutWeight(1).width('100%');}.width('100%').height('100%').backgroundColor(BG).onAreaChange((a,b)=>this.availableWidth=Number(b.width));}
}
