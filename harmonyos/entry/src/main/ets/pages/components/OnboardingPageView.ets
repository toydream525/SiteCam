const BG='#121212';const CARD='#282828';const TEXT='#F5F5F5';const MUTED='#B0BEC5';const YELLOW='#FFB300';
interface OnboardingStep {title:string;body:string;detail:string;icon:string;}
const STEPS:OnboardingStep[]=[{title:'先选工程，照片不混放',body:'拍摄前先选好工程和线路。照片、视频、问题记录会跟着当前工程保存。',detail:'进入工程项目，可以新建工程，填写名称、类别、地点和备注。',icon:'icon_folder'},{title:'横拍竖拍，自己选择',body:'按现场需要握持手机。竖屏、左横屏、右横屏或自动，都可以记住你的选择。',detail:'取景画面会跟着方向调整，水印和成片也会保持一致。',icon:'ic_orientation'},{title:'按日期找照片，随手记问题',body:'相册可以按照片拍摄年月日区间快速查找，也能只看问题记录。',detail:'拍完发现问题，直接标记一般、重要或严重，并填写处理状态。',icon:'ic_calendar'},{title:'资料统一导出，完工及时锁定',body:'导出时可选一个 ZIP 或总文件夹，每个工程都有独立目录和清单。',detail:'完工后锁定工程，暂时停用该工程快门，仍可编辑、移动、删除和导出。',icon:'ic_export'}];
@Component export struct OnboardingPageView { @Prop step:number=0; onNext:()=>void=()=>{}; onSkip:()=>void=()=>{}; @Builder icon(name:string){if(name==='icon_folder')Image($r('app.media.icon_folder')).width(96).height(96);else if(name==='ic_orientation')Image($r('app.media.ic_orientation')).width(96).height(96);else if(name==='ic_calendar')Image($r('app.media.ic_calendar')).width(96).height(96);else Image($r('app.media.ic_export')).width(96).height(96);}
 currentIndex():number{return Math.max(0,Math.min(3,this.step));}
 build(){Column(){Text('工程水印相机').fontSize(18).fontWeight(FontWeight.Bold).fontColor(MUTED).margin({top:18});Column({space:18}){this.icon(STEPS[this.currentIndex()].icon);Text(STEPS[this.currentIndex()].title).fontSize(28).fontWeight(FontWeight.Bold).fontColor(YELLOW).textAlign(TextAlign.Center);Text(STEPS[this.currentIndex()].body).fontSize(18).lineHeight(29).fontColor(TEXT).textAlign(TextAlign.Center);Text(STEPS[this.currentIndex()].detail).fontSize(14).lineHeight(22).fontColor(MUTED).textAlign(TextAlign.Center);Text(`${this.currentIndex()+1} / 4`).fontSize(13).fontColor(MUTED);Row({space:10}){Button(this.currentIndex()===3?'开始使用':'下一步').layoutWeight(1).height(50).fontSize(16).fontWeight(FontWeight.Bold).fontColor('#231A00').backgroundColor(YELLOW).onClick(()=>this.onNext());Button('跳过').height(50).fontSize(14).fontColor(MUTED).backgroundColor(CARD).onClick(()=>this.onSkip());}.width('100%');}.padding(24).layoutWeight(1).justifyContent(FlexAlign.Center);}.backgroundColor(BG).height('100%');}}
