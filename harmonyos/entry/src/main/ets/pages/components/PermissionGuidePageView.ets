const BG='#121212';const CARD='#282828';const TEXT='#F5F5F5';const MUTED='#B0BEC5';const YELLOW='#FFB300';const GREEN='#66BB6A';
export interface PermissionStatus {id:string;title:string;description:string;granted:boolean;needsSettings:boolean;optional:boolean;detail?:string;}
@Component export struct PermissionGuidePageView {
 @Prop permissions:PermissionStatus[]=[
  {id:'camera',title:'相机',description:'用于拍照和录像。不开启也能浏览、管理已有工程资料。',granted:false,needsSettings:false,optional:false},
  {id:'location',title:'位置 · 可选',description:'用于水印中的现场地点。允许大致位置也可以；不开启时照片不含定位。',granted:false,needsSettings:false,optional:true},
  {id:'microphone',title:'麦克风 · 可选',description:'用于录制视频声音。不开启时可以录制无声视频。',granted:false,needsSettings:false,optional:true}
 ];
 @Prop hasRequested:boolean=false;@Prop requesting:boolean=false;@Prop fontScale:number=1;
 private cameraGranted():boolean{const item=this.permissions.find(v=>v.id==='camera');return item!==undefined&&item.granted;}
 onBack:()=>void=()=>{};onRequest:()=>void=()=>{};onContinue:()=>void=()=>{};onOpenSettings:()=>void=()=>{};
 @Builder permissionCard(item:PermissionStatus){Row({space:14}){Stack(){Image(item.id==='camera'?$r('app.media.ic_camera'):item.id==='location'?$r('app.media.ic_location'):$r('app.media.ic_microphone')).width(28).height(28);}.width(48).height(48).backgroundColor('#FFB30022').borderRadius(14);Column({space:5}){Text(item.title).fontSize(18).fontWeight(FontWeight.Bold).fontColor(TEXT);Text(item.description).fontSize(14).lineHeight(21).fontColor(MUTED).width('100%');Text(item.granted?(item.detail||'已允许'):item.needsSettings?'未开启 · 需前往系统设置':'未开启').fontSize(13).fontColor(item.granted?GREEN:YELLOW);}.layoutWeight(1);}.padding(16).width('100%').backgroundColor(CARD).borderRadius(14);}
 build(){Column(){Row(){Image($r('app.media.ic_arrow_back')).width(24).height(24).margin({left:20,right:20}).onClick(()=>this.onBack());Text('开始前，一次设置好权限').fontSize(19).fontWeight(FontWeight.Bold).fontColor(TEXT).layoutWeight(1);}.height(64);Scroll(){Column({space:16}){Column({space:8}){Text('系统会依次询问权限').fontSize(25).fontWeight(FontWeight.Bold).fontColor(TEXT);Text('相机是拍摄必需权限。定位和麦克风都可不允许，之后仍能拍照、整理和导出资料。').fontSize(14).lineHeight(22).fontColor(MUTED);}.width('100%');ForEach(this.permissions,(item:PermissionStatus)=>this.permissionCard(item),(item:PermissionStatus)=>item.id);if(this.hasRequested)Text(this.permissions.every(v=>v.granted||v.optional)?'所需权限已就绪，可以开始使用。':'授权结果已更新。未开启的项目可稍后补充，不会再次自动弹出申请。').fontSize(14).fontColor(YELLOW).width('100%');Button(this.requesting?'请完成系统权限询问…':this.cameraGranted()?'进入相机':this.permissions.some(v=>!v.granted&&!v.needsSettings)?'开启所需权限':'去系统设置开启').width('100%').height(50).fontSize(16).fontColor('#231A00').backgroundColor(YELLOW).enabled(!this.requesting).onClick(()=>{if(this.cameraGranted())this.onContinue();else if(this.permissions.some(v=>!v.granted&&!v.needsSettings))this.onRequest();else this.onOpenSettings();});if(this.hasRequested&&this.permissions.some(v=>v.needsSettings))Button('去系统设置补充权限').width('100%').height(46).fontSize(15).fontColor(YELLOW).backgroundColor(Color.Transparent).borderColor('#555555').borderWidth(1).onClick(()=>this.onOpenSettings());Button(this.hasRequested?'稍后补充，先管理资料':'暂时跳过').width('100%').height(44).fontSize(14).fontColor(MUTED).backgroundColor(Color.Transparent).enabled(!this.requesting).onClick(()=>this.onContinue());Text('不会申请后台定位、通知或存储权限。系统相册默认关闭，需要时再到设置开启。').fontSize(12).lineHeight(18).fontColor(MUTED).width('100%');}.padding({left:20,right:20,top:16,bottom:24});}.layoutWeight(1).scrollBar(BarState.Off);}.backgroundColor(BG).height('100%');}
}
