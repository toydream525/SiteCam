interface GuideSection {title:string;lines:string[];}
const BG='#121212';const CARD='#282828';const TEXT='#F5F5F5';const MUTED='#B0BEC5';const YELLOW='#FFB300';
const GUIDE:GuideSection[]=[
 {title:"使用指南",lines:["SiteCam（工程水印相机）面向施工记录、现场巡检和工程留档。工程资料默认留在手机本地，无需注册账号。下面用虚构的“滨江路雨污分流改造”工程说明常用操作。","本版：0.2.8","系统要求：Android 8.0（API 26）及以上"]},
 {title:"安装与权限",lines:["从项目官网或 GitHub Releases 下载 APK，安装后打开 SiteCam。","完成或跳过首次功能指引后进入权限指引，点“开启所需权限”，集中申请当前尚未授权的相机、定位和麦克风权限。","定位和录音是可选的，可以暂时跳过；相机未授权时不能拍摄。已经授予的权限不会重复申请。","以后缺少权限时，从相机页出现的提示按需补开；定位拒绝后仍可拍照、录像和导出，录音拒绝后仍可录制无声视频。"]},
 {title:"首次功能指引",lines:["新装或首次使用会看到 4 页指引：先选工程、选择横竖方向、按日期找资料和导出锁定。","点“跳过”或最后一页的“开始使用”后，以后启动和正常升级都不会自动显示。","中途退出且没有跳过，下一次打开会继续显示；指引状态会在手机本地保存。","指引完成或跳过后进入权限指引，点“开启所需权限”，集中申请尚未授权的相机、定位和麦克风；定位和录音可暂时跳过，完成授权或点击暂时跳过后，之后不再自动弹出，已有全授予会直接跳过。","以后缺少权限时，从相机页的提示按需补开；进入“设置 → 使用技巧与教程 → 重新查看功能指引”可以随时重看，且不会清空已完成状态。"]},
 {title:"工程与线路",lines:["在相机页点左上角工程名称进入工程包页，点右上角“新建”，填写工程名称；类别、地点和备注按需要填写。","每个工程建一个工程包，线路名称可按需要填写。例如工程填写“滨江路雨污分流改造”，线路填写“北段雨水管”。","工程卡片上可以编辑名称、类别、地点和备注，也可以归档；在归档列表中可以恢复。","长按或进入批量操作，可批量分类、归档、锁定、解锁、删除或导出工程。删除前先导出需要留档的资料。","搜索工程或线路名称即可定位资料；锁定当前工程只会停用该工程的新拍照和录像，不会自动切换工程，编辑、移动、删除和导出仍可使用。"]},
 {title:"拍照、录像与水印",lines:["先选工程和线路，再在取景页点击快门拍照；切换到录像后点一次开始、再点一次结束。当前工程会记录照片和视频数量。","闪光灯短按在自动、开启、关闭之间切换；长按闪光灯图标可开关常亮手电。","点取景页顶部的拍摄方向图标，默认使用自动；也可选择竖屏、左横屏或右横屏，应用会记住你的选择。画面和成片会保持同一方向。","允许定位后，水印可显示地点；在工程编辑页维护工程名称、线路、类别、地点和备注，在设置中选择要显示的水印字段与自定义字段。拍摄时间由记录自动写入，字段较多时会自动排版。水印样式可在“设置 → 自定义水印字段与样式”或取景页直接点水印卡片后更换。","画质提供四档：更小文件、标准省空间（默认）、较清晰、原尺寸高清。拍摄和编辑都能使用这组选择。"]},
 {title:"更换水印样式",lines:["在设置打开“自定义水印字段与样式”，或在取景页点水印卡片进入快速修改，再点“更换样式”。","面板提供八款样式：经典工程水印、极简水印、工程信息板、蓝白工程记录、施工表格、巡检记录、验收记录、大字时间地点。","点卡片查看大预览，先比较版式和信息位置；原有字段、字号和不透明度会保留。","确定后点“使用此样式”才保存，点“取消”会回到原来的样式。"]},
 {title:"相册、搜索与日期",lines:["点相机页缩略图进入当前工程相册。工程卡片显示照片、视频和问题数量。工程会自动记录首拍日期和末拍日期；还没有拍摄时显示“尚未拍摄”。","在工程管理中搜索工程或线路，并按最近拍摄、创建时间、编辑时间、工程名或线路首字母升序/降序排列。","在相册中用年月日区间筛选照片，例如只看 2026 年 9 月 1 日到 9 月 3 日的夜间施工记录。","多选照片或视频后，可移动、分享、导出或删除；操作前确认当前工程范围，避免把资料放错线路。","相册可查看全部工程或指定工程。拍摄前回到相机页，确认左上角的工程名称。"]},
 {title:"记录和跟进问题",lines:["拍摄时点右上角三角形问题按钮，再拍下需要跟进的位置；也可以在相册里点“标记问题”。","填写问题名称和说明，选择“一般、重要、严重”级别，再保存。","打开已有问题的照片或视频，点“编辑问题”，选择“待处理”“处理中”或“已完成”后保存。","问题会关联照片或视频，导出工程包时会随清单和报告一起带走。"]},
 {title:"查看、编辑与标注",lines:["打开详情后可在 1 到 8 倍之间缩放；双击放大或还原，双指拖动查看画面细节。","编辑时可水平翻转、垂直翻转、旋转 90 度或自由裁剪，也可以撤销和重做。","现场标注支持箭头、矩形、圆形、画笔、文字和马赛克，适合指出管线、裂缝或需要整改的位置。","详情页可以切换原图和独立成品。保存成品不会覆盖原图，水印会跟着整张图的方向和裁剪一起变换。","分享或导出前检查成品是否包含需要的标注和水印，原图仍可留作复核。"]},
 {title:"导出工程资料",lines:["在工程管理或相册中选择一个工程、多个工程或选中的照片或视频，点击“导出”。","可选择一个 ZIP，或选择一个总文件夹。总文件夹里每个工程都有独立目录，便于交给不同班组。","每个工程目录包含照片、视频、编辑成品、工程信息、照片和视频清单及报告；文件名会保留工程和日期线索。","导出时可保持原文件（默认），也可生成压缩副本。压缩副本不会替换手机里保存的原文件。","完工确认后锁定工程，减少误拍；锁定后仍可补充备注、移动、删除和导出既有资料。"]},
 {title:"保存位置与换机",lines:["保存到系统相册默认关闭；新照片、视频和编辑成品默认保存在 SiteCam 内，打开设置后也可保存到系统相册供其他应用使用。","“另存到系统相册”会创建独立副本。原件与系统相册副本分开保存，开关只影响之后保存的资料，不搬动旧文件。","删除系统相册副本不会删除工程原件；删除工程资料也不会自动删除系统相册副本。取消授权不影响工程内保存。","换机或卸载前先导出各工程的 ZIP 或总文件夹，再把资料保存到新手机查看；当前版本不提供把工程恢复成可继续拍摄工程的功能。"]},
 {title:"隐私与常见处理",lines:["SiteCam 无广告、无账号和自动上传；工程、照片、视频、地点水印和问题记录默认只在本机使用。","地点没有显示时，检查系统定位开关和应用权限；室内或刚到现场时等待定位稳定即可。","录像没有声音时，重新开启麦克风权限后再开始下一段录像；已经拍好的无声视频不会自动补录声音。","字段太多时，到“设置 → 自定义水印字段与样式”减少字段或调整字号，再拍摄新的记录。","提交反馈前遮住工程名称、地址、地点、时间、人员和车辆信息，不要公开真实工程资料或签名文件。"]},
 {title:"获取帮助",lines:["在设置中打开“使用技巧与教程”，没有网络也能阅读本指南。","反馈问题时写明设备型号、HarmonyOS 版本、所在页面、操作步骤和预期结果。","需要复现问题时使用虚构工程和脱敏截图，保留导出的报告以便核对。"]},
 {title:"更换桌面图标",lines:["打开“设置 → 桌面图标”，先查看当前选中的图标样式。","新装默认使用 D「工程现场」；也可选择 A「蓝图镜头」、B「工程印记」或 C「现场坐标」，选择会立即生效，返回桌面查看。","切换只影响桌面入口，工程资料、拍摄记录和应用内页面不受影响。","重启或正常升级后会保留你的选择；如果桌面暂未刷新，稍等片刻或重新打开桌面。","作者：ninjaaqua","GitHub：@toydream525"]},
 {title:"鸿蒙开发版与多设备",lines:["当前为 v0.2.8 鸿蒙原生开发版，安装包未签名，需要开发环境；不作为普通真机发行包。","普通手机使用单栏，窗口达到 600 vp 显示更多列，840 vp 起使用列表和详情双栏；展开、旋转后保留当前资料及多选。","大屏照片编辑在右侧显示工具，相机侧边水印面板可滚动。","真实平板、悬停、HarmonyOS 5/6 与硬件视频仍待验收。模拟器没有 H.264 编解码器时，视频处理会保留原片供重试。","官方说明与下载：yuriaqua.com/sitecam/；GitHub：toydream525/SiteCam。"]}
];
@Component export struct HelpPageView { @Prop sections:GuideSection[]=GUIDE; @State selected:string=''; onBack:()=>void=()=>{}; onReplayGuide:()=>void=()=>{}; currentSection(): GuideSection|null { return this.sections.find((v:GuideSection)=>v.title===this.selected)||null; }
 @Builder section(s:GuideSection){Column({space:7}){Text(s.title).fontSize(17).fontWeight(FontWeight.Bold).fontColor(YELLOW);ForEach(s.lines,(line:string)=>Text('• '+line).fontSize(14).lineHeight(23).fontColor(TEXT).width('100%'),(line:string)=>line);}.padding(16).backgroundColor(CARD).borderRadius(12);}
 build(){Column(){Row(){Button(){Image($r('app.media.ic_arrow_back')).width(24).height(24);}.width(48).height(48).backgroundColor(Color.Transparent).onClick(()=>this.onBack());Text('使用技巧与教程').fontSize(18).fontWeight(FontWeight.Bold).fontColor(TEXT);Blank();}.height(64).width('100%').alignItems(VerticalAlign.Center);Scroll(){Column(){Scroll(){Row({space:8}){ForEach(this.sections,(sec:GuideSection)=>Button(sec.title).fontSize(12).fontColor(this.selected===sec.title?'#231A00':MUTED).backgroundColor(this.selected===sec.title?YELLOW:CARD).borderRadius(8).onClick(()=>this.selected=sec.title),(sec:GuideSection)=>sec.title);}.padding({left:16,right:16,top:8,bottom:8});}.width('100%').scrollable(ScrollDirection.Horizontal);if(this.currentSection())this.section(this.currentSection() as GuideSection);else{Column({space:12}){Text('工程现场使用指南 · v0.2.8').fontSize(20).fontWeight(FontWeight.Bold).fontColor(TEXT);Text('章节目录').fontSize(16).fontWeight(FontWeight.Bold).fontColor(YELLOW);ForEach(this.sections,(sec:GuideSection)=>Text('› '+sec.title).fontSize(15).fontColor(TEXT).padding(8).onClick(()=>this.selected=sec.title),(sec:GuideSection)=>sec.title);}.padding(16);}Button('重新查看首次功能指引').width('100%').height(48).fontColor('#231A00').backgroundColor(YELLOW).onClick(()=>this.onReplayGuide());}.width('100%').alignItems(HorizontalAlign.Start);}.layoutWeight(1);}.alignItems(HorizontalAlign.Start).backgroundColor(BG).height('100%');}
}
