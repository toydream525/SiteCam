import { relationalStore, preferences } from '@kit.ArkData';
import { common } from '@kit.AbilityKit';
import { Project, MediaItem, Settings, WatermarkTemplate, WatermarkField, ProjectCategory, Issue, Annotation, Snapshot, Fix } from './Models';
interface TemplateConfig { style?:string; fontScale?:number; opacity?:number; position?:string; }
class SnapshotRow { id:number=0; latitude:number|null=null; longitude:number|null=null; altitude:number|null=null; accuracy:number|null=null; timestamp:number|null=null; locationStatus:string='UNAVAILABLE'; snapshotAddress:string=''; }

export class Store {
  private namespace:string; private db:relationalStore.RdbStore|null=null; private pref:preferences.Preferences|null=null; settings:Settings=new Settings();
  constructor(namespace:string='sitecam'){this.namespace=namespace;}
  async open(context:common.Context):Promise<void>{
    this.pref=await preferences.getPreferences(context,{name:this.namespace+'_settings'});
    const saved=await this.pref.get('settings',''); if(saved){const old=JSON.parse(saved as string) as Settings;const defaults=new Settings();this.settings=old;this.settings.watermark=old.watermark||defaults.watermark;if(this.settings.editQuality!==this.settings.photoQuality)this.settings.editQuality=this.settings.photoQuality;}
    this.db=await relationalStore.getRdbStore(context,{name:this.namespace+'.db',securityLevel:relationalStore.SecurityLevel.S1});
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS projects (id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,route TEXT,category TEXT,address TEXT,notes TEXT,archived INTEGER,locked INTEGER,created INTEGER,updated INTEGER)');
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS media (id INTEGER PRIMARY KEY AUTOINCREMENT,projectId INTEGER NOT NULL,path TEXT,source TEXT,edited TEXT,albumUri TEXT,name TEXT,type TEXT,timestamp INTEGER,width INTEGER,height INTEGER,duration INTEGER,rotation INTEGER,status TEXT,snapshot TEXT,issueTitle TEXT,issueNotes TEXT,severity TEXT,issueStatus TEXT)');
    try { this.db!.beginTransaction();
    await this.addColumns('projects',["description TEXT DEFAULT ''","coverMediaId INTEGER DEFAULT 0","watermarkTemplateId INTEGER DEFAULT 1","isCaptureLocked INTEGER DEFAULT 0"]);
    await this.addColumns('media',["contentUri TEXT DEFAULT ''","filePath TEXT DEFAULT ''","latitude REAL","longitude REAL","altitude REAL","locationAccuracy REAL","locationTimestamp INTEGER","locationStatus TEXT DEFAULT 'UNAVAILABLE'","addressText TEXT DEFAULT ''","isIssue INTEGER DEFAULT 0","isFavorite INTEGER DEFAULT 0","createdAt INTEGER DEFAULT 0"]);
    await this.db.executeSql('CREATE INDEX IF NOT EXISTS media_project_time ON media(projectId,timestamp)'); await this.db.executeSql("UPDATE media SET status='FAILED' WHERE status='PROCESSING'");
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS watermark_templates (id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,config TEXT NOT NULL,updated INTEGER)');
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS watermark_fields (id INTEGER PRIMARY KEY AUTOINCREMENT,templateId INTEGER NOT NULL,fieldKey TEXT,label TEXT,defaultValue TEXT,displayOrder INTEGER,isEnabled INTEGER)');
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS project_categories (id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,isSystemDefault INTEGER DEFAULT 0,displayOrder INTEGER DEFAULT 0)');
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS issues (id INTEGER PRIMARY KEY AUTOINCREMENT,projectId INTEGER NOT NULL,mediaId INTEGER NOT NULL UNIQUE,title TEXT,description TEXT,severity TEXT,status TEXT,createdAt INTEGER,updatedAt INTEGER)');
    await this.db.executeSql('CREATE TABLE IF NOT EXISTS annotations (id INTEGER PRIMARY KEY AUTOINCREMENT,mediaId INTEGER NOT NULL UNIQUE,annotatedContentUri TEXT,vectorDataJson TEXT,createdAt INTEGER)');
    await this.db.executeSql("INSERT OR IGNORE INTO issues(projectId,mediaId,title,description,severity,status,createdAt,updatedAt) SELECT projectId,id,issueTitle,issueNotes,severity,issueStatus,timestamp,timestamp FROM media WHERE LENGTH(issueTitle)>0");
    await this.backfillSnapshots(); this.db!.commit(); } catch(e) { this.db!.rollBack(); throw e as Error; } await this.ensureCategories(); if(!(await this.templates()).length){const t=new WatermarkTemplate();t.config=JSON.stringify(this.settings.watermark);await this.putTemplate(t);this.settings.templateId=t.id;await this.saveSettings();} this.db.version=4; await this.pref!.put('schemaVersion',4); await this.pref!.flush();
  }
  async saveSettings():Promise<void>{await this.pref!.put('settings',JSON.stringify(this.settings));await this.pref!.flush();}
  async projects(sort:string='UPDATED',ascending:boolean=false,archive:string='ALL'):Promise<Project[]>{
    const rs=await this.db!.querySql("SELECT p.*,COUNT(m.id) AS count,SUM(CASE WHEN m.type='PHOTO' THEN 1 ELSE 0 END) AS photoCount,SUM(CASE WHEN m.type='VIDEO' THEN 1 ELSE 0 END) AS videoCount,SUM(CASE WHEN LENGTH(m.issueTitle)>0 OR m.isIssue=1 THEN 1 ELSE 0 END) AS issueCount,MIN(m.timestamp) AS first,MAX(m.timestamp) AS last FROM projects p LEFT JOIN media m ON m.projectId=p.id WHERE (?='ALL' OR (?='ACTIVE' AND p.archived=0) OR (?='ARCHIVED' AND p.archived=1)) GROUP BY p.id",[archive,archive,archive]);const a:Project[]=[];try{while(rs.goToNextRow()){const p=new Project();p.id=this.num(rs,'id');p.name=this.str(rs,'name');p.route=this.str(rs,'route');p.category=this.str(rs,'category')||'建筑';p.categoryName=p.category;p.address=this.str(rs,'address');p.notes=this.str(rs,'notes');p.description=this.str(rs,'description')||p.notes;p.archived=this.num(rs,'archived')===1;p.locked=this.num(rs,'locked')===1||this.num(rs,'isCaptureLocked')===1;p.isCaptureLocked=p.locked;p.created=this.num(rs,'created');p.updated=this.num(rs,'updated');p.coverMediaId=this.num(rs,'coverMediaId');p.watermarkTemplateId=this.num(rs,'watermarkTemplateId')||1;p.count=this.num(rs,'count');p.photoCount=this.num(rs,'photoCount');p.videoCount=this.num(rs,'videoCount');p.issueCount=this.num(rs,'issueCount');p.first=this.num(rs,'first');p.last=this.num(rs,'last');a.push(p);}}finally{rs.close();}a.sort((x,y)=>{const ex=sort==='LAST_CAPTURE'?x.last===0:sort==='ROUTE'?!x.route:false,ey=sort==='LAST_CAPTURE'?y.last===0:sort==='ROUTE'?!y.route:false;if(ex!==ey)return ex?1:-1;let n=sort==='LAST_CAPTURE'?x.last-y.last:sort==='CREATED'?x.created-y.created:sort==='NAME'?x.name.localeCompare(y.name,'zh'):sort==='ROUTE'?x.route.localeCompare(y.route,'zh'):x.updated-y.updated;return n===0?x.id-y.id:(ascending?n:-n);});return a;
  }
  async putProject(p:Project):Promise<void>{p.updated=Date.now();const v:relationalStore.ValuesBucket={name:p.name,route:p.route,category:p.category||p.categoryName,address:p.address,notes:p.notes,description:p.notes,archived:p.archived?1:0,locked:p.locked?1:0,isCaptureLocked:p.locked?1:0,created:p.created,updated:p.updated,coverMediaId:p.coverMediaId,watermarkTemplateId:p.watermarkTemplateId};if(p.id)await this.db!.update(v,new relationalStore.RdbPredicates('projects').equalTo('id',p.id));else p.id=await this.db!.insert('projects',v);}
  async media():Promise<MediaItem[]>{const rs=await this.db!.querySql('SELECT * FROM media ORDER BY timestamp DESC');const a:MediaItem[]=[];try{while(rs.goToNextRow()){const m=new MediaItem();m.id=this.num(rs,'id');m.projectId=this.num(rs,'projectId');m.path=this.str(rs,'path');m.source=this.str(rs,'source');m.edited=this.str(rs,'edited');m.albumUri=this.str(rs,'albumUri');m.name=this.str(rs,'name');m.type=this.str(rs,'type');m.timestamp=this.num(rs,'timestamp');m.width=this.num(rs,'width');m.height=this.num(rs,'height');m.duration=this.num(rs,'duration');m.rotation=this.num(rs,'rotation');m.status=this.str(rs,'status');m.snapshot=this.str(rs,'snapshot');m.issueTitle=this.str(rs,'issueTitle');m.issueNotes=this.str(rs,'issueNotes');m.severity=this.str(rs,'severity')||'NORMAL';m.issueStatus=this.str(rs,'issueStatus')||'PENDING';m.contentUri=this.str(rs,'contentUri');m.filePath=this.str(rs,'filePath');m.latitude=this.nullNum(rs,'latitude');m.longitude=this.nullNum(rs,'longitude');m.altitude=this.nullNum(rs,'altitude');m.locationAccuracy=this.nullNum(rs,'locationAccuracy');m.locationTimestamp=this.nullNum(rs,'locationTimestamp');m.locationStatus=this.str(rs,'locationStatus')||'UNAVAILABLE';m.addressText=this.str(rs,'addressText');m.isIssue=this.num(rs,'isIssue')===1||!!m.issueTitle;m.isFavorite=this.num(rs,'isFavorite')===1;m.createdAt=this.num(rs,'createdAt')||m.timestamp;a.push(m);}}finally{rs.close();}return a;}
  async putMedia(m:MediaItem):Promise<void>{const now=Date.now();const v:relationalStore.ValuesBucket={projectId:m.projectId,path:m.path,source:m.source,edited:m.edited,albumUri:m.albumUri,name:m.name,type:m.type,timestamp:m.timestamp,width:m.width,height:m.height,duration:m.duration,rotation:m.rotation,status:m.status,snapshot:m.snapshot,issueTitle:m.issueTitle,issueNotes:m.issueNotes,severity:m.severity,issueStatus:m.issueStatus,contentUri:m.contentUri||m.path,filePath:m.filePath||m.path,latitude:m.latitude,longitude:m.longitude,altitude:m.altitude,locationAccuracy:m.locationAccuracy,locationTimestamp:m.locationTimestamp,locationStatus:m.locationStatus,addressText:m.addressText,isIssue:m.issueTitle?1:0,isFavorite:m.isFavorite?1:0,createdAt:m.createdAt||now};this.db!.beginTransaction();try{if(m.id)await this.db!.update(v,new relationalStore.RdbPredicates('media').equalTo('id',m.id));else m.id=await this.db!.insert('media',v);const old=await this.issuesByMedia(m.id);if(m.issueTitle){const i=old.length?old[0]:new Issue();i.projectId=m.projectId;i.mediaId=m.id;i.title=m.issueTitle;i.description=m.issueNotes;i.severity=m.severity;i.status=m.issueStatus;i.createdAt=i.createdAt||now;i.updatedAt=now;await this.putIssueNoTx(i);}else if(old.length)await this.db!.delete(new relationalStore.RdbPredicates('issues').equalTo('mediaId',m.id));this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  async moveMedia(ids:number[],target:number):Promise<void>{if(!(await this.projects('UPDATED',false,'ALL')).some(p=>p.id===target))throw new Error('目标工程不存在');this.db!.beginTransaction();try{for(const id of ids){await this.db!.update({projectId:target},new relationalStore.RdbPredicates('media').equalTo('id',id));await this.db!.update({projectId:target},new relationalStore.RdbPredicates('issues').equalTo('mediaId',id));}this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  async deleteMedia(id:number):Promise<void>{this.db!.beginTransaction();try{await this.db!.delete(new relationalStore.RdbPredicates('annotations').equalTo('mediaId',id));await this.db!.delete(new relationalStore.RdbPredicates('issues').equalTo('mediaId',id));await this.db!.delete(new relationalStore.RdbPredicates('media').equalTo('id',id));this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  async deleteMediaBatch(ids:number[]):Promise<number[]>{const f:number[]=[];for(const id of ids){try{await this.deleteMedia(id);}catch(e){f.push(id);}}return f;}
  async deleteMany(ids:number[]):Promise<number[]>{return this.deleteMediaBatch(ids);}
  async deleteProject(id:number):Promise<void>{this.db!.beginTransaction();try{const rs=await this.db!.querySql('SELECT id FROM media WHERE projectId=?',[id]);const ids:number[]=[];try{while(rs.goToNextRow())ids.push(this.num(rs,'id'));}finally{rs.close();}for(const mid of ids){await this.db!.delete(new relationalStore.RdbPredicates('annotations').equalTo('mediaId',mid));await this.db!.delete(new relationalStore.RdbPredicates('issues').equalTo('mediaId',mid));}await this.db!.delete(new relationalStore.RdbPredicates('issues').equalTo('projectId',id));await this.db!.delete(new relationalStore.RdbPredicates('media').equalTo('projectId',id));await this.db!.delete(new relationalStore.RdbPredicates('projects').equalTo('id',id));this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  async putIssue(i:Issue):Promise<void>{this.db!.beginTransaction();try{const existing=await this.issuesByMedia(i.mediaId);if(existing.length)i.id=existing[0].id;await this.putIssueNoTx(i);await this.db!.update({issueTitle:i.title,issueNotes:i.description,severity:i.severity,issueStatus:i.status,isIssue:i.title?1:0},new relationalStore.RdbPredicates('media').equalTo('id',i.mediaId));this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  private async putIssueNoTx(i:Issue):Promise<void>{i.updatedAt=Date.now();const v:relationalStore.ValuesBucket={projectId:i.projectId,mediaId:i.mediaId,title:i.title,description:i.description,severity:i.severity,status:i.status,createdAt:i.createdAt,updatedAt:i.updatedAt};if(i.id)await this.db!.update(v,new relationalStore.RdbPredicates('issues').equalTo('id',i.id));else i.id=await this.db!.insert('issues',v);}
  private async issuesByMedia(id:number):Promise<Issue[]>{const rs=await this.db!.querySql('SELECT * FROM issues WHERE mediaId=?',[id]);const a:Issue[]=[];try{while(rs.goToNextRow()){const i=new Issue();i.id=this.num(rs,'id');i.projectId=this.num(rs,'projectId');i.mediaId=this.num(rs,'mediaId');i.title=this.str(rs,'title');i.description=this.str(rs,'description');i.severity=this.str(rs,'severity');i.status=this.str(rs,'status');i.createdAt=this.num(rs,'createdAt');a.push(i);}}finally{rs.close();}return a;}
  async issues(projectId?:number):Promise<Issue[]>{const rs=projectId===undefined?await this.db!.querySql('SELECT * FROM issues'):await this.db!.querySql('SELECT * FROM issues WHERE projectId=?',[projectId]);const a:Issue[]=[];try{while(rs.goToNextRow()){const i=new Issue();i.id=this.num(rs,'id');i.projectId=this.num(rs,'projectId');i.mediaId=this.num(rs,'mediaId');i.title=this.str(rs,'title');i.description=this.str(rs,'description');i.severity=this.str(rs,'severity');i.status=this.str(rs,'status');i.createdAt=this.num(rs,'createdAt');i.updatedAt=this.num(rs,'updatedAt');a.push(i);}}finally{rs.close();}return a;}
  async putAnnotation(a:Annotation):Promise<void>{this.db!.beginTransaction();try{const old=await this.annotations(a.mediaId);if(old.length)a.id=old[0].id;const v:relationalStore.ValuesBucket={mediaId:a.mediaId,annotatedContentUri:a.annotatedContentUri,vectorDataJson:a.vectorDataJson,createdAt:a.createdAt};if(a.id)await this.db!.update(v,new relationalStore.RdbPredicates('annotations').equalTo('id',a.id));else a.id=await this.db!.insert('annotations',v);await this.db!.update({edited:a.annotatedContentUri},new relationalStore.RdbPredicates('media').equalTo('id',a.mediaId));this.db!.commit();}catch(e){this.db!.rollBack();throw e as Error;}}
  async annotations(mediaId?:number):Promise<Annotation[]>{const rs=mediaId===undefined?await this.db!.querySql('SELECT * FROM annotations'):await this.db!.querySql('SELECT * FROM annotations WHERE mediaId=?',[mediaId]);const a:Annotation[]=[];try{while(rs.goToNextRow()){const x=new Annotation();x.id=this.num(rs,'id');x.mediaId=this.num(rs,'mediaId');x.annotatedContentUri=this.str(rs,'annotatedContentUri');x.vectorDataJson=this.str(rs,'vectorDataJson');x.createdAt=this.num(rs,'createdAt');a.push(x);}}finally{rs.close();}return a;}
  async categories():Promise<ProjectCategory[]>{const rs=await this.db!.querySql('SELECT * FROM project_categories ORDER BY displayOrder,id');const a:ProjectCategory[]=[];try{while(rs.goToNextRow()){const c=new ProjectCategory();c.id=this.num(rs,'id');c.name=this.str(rs,'name');c.displayOrder=this.num(rs,'displayOrder');c.isSystemDefault=this.num(rs,'isSystemDefault')===1;a.push(c);}}finally{rs.close();}return a;}
  async putCategory(c:ProjectCategory):Promise<void>{const v:relationalStore.ValuesBucket={name:c.name,isSystemDefault:c.isSystemDefault?1:0,displayOrder:c.displayOrder};if(c.id)await this.db!.update(v,new relationalStore.RdbPredicates('project_categories').equalTo('id',c.id));else c.id=await this.db!.insert('project_categories',v);}
  async templates():Promise<WatermarkTemplate[]>{const rs=await this.db!.querySql('SELECT * FROM watermark_templates ORDER BY updated DESC');const a:WatermarkTemplate[]=[];try{while(rs.goToNextRow()){const t=new WatermarkTemplate();t.id=this.num(rs,'id');t.name=this.str(rs,'name');t.config=this.str(rs,'config');t.updated=this.num(rs,'updated');try{const c=JSON.parse(t.config) as TemplateConfig;t.styleType=c.style||t.styleType;t.fontSizeScale=c.fontScale||t.fontSizeScale;t.opacity=c.opacity||t.opacity;t.position=c.position||t.position;}catch(e){}a.push(t);}}finally{rs.close();}return a;}
  async putTemplate(t:WatermarkTemplate):Promise<void>{t.updated=Date.now();let config=t.config;if(!config){const c:TemplateConfig={style:t.styleType,fontScale:t.fontSizeScale,opacity:t.opacity,position:t.position};config=JSON.stringify(c);t.config=config;}const v:relationalStore.ValuesBucket={name:t.name,config:config,updated:t.updated};if(t.id)await this.db!.update(v,new relationalStore.RdbPredicates('watermark_templates').equalTo('id',t.id));else t.id=await this.db!.insert('watermark_templates',v);}
  async renameTemplate(id:number,name:string):Promise<void>{await this.db!.update({name:name.trim()||'未命名模板',updated:Date.now()},new relationalStore.RdbPredicates('watermark_templates').equalTo('id',id));}
  async templateFields(id:number):Promise<WatermarkField[]>{const rs=await this.db!.querySql('SELECT * FROM watermark_fields WHERE templateId=? ORDER BY displayOrder,id',[id]);const a:WatermarkField[]=[];try{while(rs.goToNextRow()){const f=new WatermarkField();f.id=this.num(rs,'id');f.templateId=this.num(rs,'templateId');f.fieldKey=this.str(rs,'fieldKey');f.label=this.str(rs,'label');f.defaultValue=this.str(rs,'defaultValue');f.displayOrder=this.num(rs,'displayOrder');f.isEnabled=this.num(rs,'isEnabled')!==0;a.push(f);}}finally{rs.close();}return a;}
  async putTemplateField(f:WatermarkField):Promise<void>{const v:relationalStore.ValuesBucket={templateId:f.templateId,fieldKey:f.fieldKey,label:f.label,defaultValue:f.defaultValue,displayOrder:f.displayOrder,isEnabled:f.isEnabled?1:0};if(f.id)await this.db!.update(v,new relationalStore.RdbPredicates('watermark_fields').equalTo('id',f.id));else f.id=await this.db!.insert('watermark_fields',v);}
  async close():Promise<void>{await this.db?.close();this.db=null;}
  private async backfillSnapshots():Promise<void>{const rs=await this.db!.querySql("SELECT id,snapshot FROM media WHERE snapshot IS NOT NULL AND LENGTH(snapshot)>0");const rows:SnapshotRow[]=[];try{while(rs.goToNextRow()){const text=this.str(rs,'snapshot');if(!text)continue;const x=JSON.parse(text) as Snapshot;if(x.fix){const row=new SnapshotRow();row.id=this.num(rs,'id');row.latitude=x.fix.latitude;row.longitude=x.fix.longitude;row.altitude=x.fix.altitude;row.accuracy=x.fix.accuracy;row.timestamp=x.fix.timestamp;row.locationStatus=x.locationStatus||'UNAVAILABLE';row.snapshotAddress=x.address||'';rows.push(row);}}}catch(e){throw e as Error;}finally{rs.close();}for(const r of rows){const v:relationalStore.ValuesBucket={latitude:r.latitude,longitude:r.longitude,altitude:r.altitude,locationAccuracy:r.accuracy,locationTimestamp:r.timestamp,locationStatus:r.locationStatus,addressText:r.snapshotAddress};await this.db!.update(v,new relationalStore.RdbPredicates('media').equalTo('id',r.id));}}
  private async addColumns(t:string,cs:string[]):Promise<void>{const rs=await this.db!.querySql('PRAGMA table_info('+t+')');const have:string[]=[];try{while(rs.goToNextRow())have.push(this.str(rs,'name'));}finally{rs.close();}for(const c of cs){const name=c.split(' ')[0];if(!have.includes(name))await this.db!.executeSql('ALTER TABLE '+t+' ADD COLUMN '+c);}} private async ensureCategories():Promise<void>{if((await this.categories()).length===0){for(const n of ['建筑','道路','水利','电力','其他']){const c=new ProjectCategory();c.name=n;c.isSystemDefault=true;c.displayOrder=['建筑','道路','水利','电力','其他'].indexOf(n);await this.putCategory(c);}}} private str(r:relationalStore.ResultSet,k:string):string{const i=r.getColumnIndex(k);return i<0||r.isColumnNull(i)?'':r.getString(i);} private num(r:relationalStore.ResultSet,k:string):number{const i=r.getColumnIndex(k);return i<0||r.isColumnNull(i)?0:r.getLong(i);} private nullNum(r:relationalStore.ResultSet,k:string):number|null{const i=r.getColumnIndex(k);return i<0||r.isColumnNull(i)?null:r.getDouble(i);}
}
export const store=new Store();
